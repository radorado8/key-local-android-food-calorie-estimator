{
  "expo": {
    "name": "Calories AI Local",
    "slug": "android-food-calorie-estimator",
    "scheme": "keylocalfoodestimator",
    "version": "1.0.10",
    "orientation": "default",
    "icon": "./assets/icon_key_fire_android.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/mensie_512_smooth.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rados.caloriesai"
    },
    "android": {
      "package": "com.rados.keylocalandroidfoodcalorieestimator",
      "versionCode": 147,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon_key_fire_android.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26,
            "ndkVersion": "27.2.12479018",
            "gradleProperties": {
              "org.gradle.jvmargs": "-Xmx4g -XX:MaxMetaspaceSize=1g"
            }
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Povoliť prístup k fotkám pre analýzu jedla.",
          "cameraPermission": "Povoliť prístup k fotoaparátu pre odfotenie jedla."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Povoliť prístup k fotoaparátu pre odfotenie jedla."
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-document-picker",
      "expo-file-system",
      [
        "expo-health-connect",
        {
          "permissions": [
            "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
            "android.permission.health.WRITE_ACTIVE_CALORIES_BURNED"
          ]
        }
      ],
      "./plugins/withShortcutIcons",
      "./plugins/withExtractNativeLibs",
      "./plugins/withAllModulesBuildTools",
      "./plugins/withIosPodsDeploymentTarget",
      "./plugins/withIosSceneLifecycle",
      [
        "expo-splash-screen",
        {
          "image": "./assets/mensie_512_smooth.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/mensie_512_smooth.png",
            "backgroundColor": "#0B0F14"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Povoliť prístup k mikrofónu pre nadiktovanie jedla."
        }
      ]
    ],
    "extra": {
      "allowedEmails": [],
      "eas": {
        "projectId": "66626bfd-c13b-4883-a7bd-c6d9d8b522c4"
      }
    }
  }
}
